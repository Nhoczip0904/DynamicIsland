<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="480" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <!-- Character beside the island; X offset follows the island's width from code -->
    <Image x:Name="Chibi" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
           Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,1">
        <Image.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ChibiSquash" />
                <TranslateTransform x:Name="ChibiOffset" />
            </TransformGroup>
        </Image.RenderTransform>
    </Image>

    <Border x:Name="Island" Width="190" Height="34" CornerRadius="17"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            ClipToBounds="True"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
        <Border.ContextMenu>
            <ContextMenu Opened="Menu_Opened">
                <MenuItem x:Name="StartupItem" Header="Chạy khi khởi động Windows" IsCheckable="True" Click="Startup_Click" />
                <MenuItem x:Name="ScreenMenu" Header="Hiện trên màn hình" />
                <MenuItem Header="Chọn nhân vật (gif)…" Click="PickCharacter_Click" />
                <MenuItem x:Name="RemoveCharacterItem" Header="Bỏ nhân vật" Click="RemoveCharacter_Click" />
                <Separator />
                <MenuItem Header="Thoát" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Compact: small cover, title, equalizer -->
            <Grid x:Name="Compact" Margin="6,0,12,0" Height="34" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SmallArt" Width="22" Height="22" CornerRadius="11" Background="#333" />
                <TextBlock x:Name="SmallTitle" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                           Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" Text="Không có nhạc" />
                <StackPanel x:Name="Equalizer" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14" />
            </Grid>

            <!-- Level: volume / brightness while it changes -->
            <Grid x:Name="Level" Margin="16,0" Height="40" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LevelGlyph" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="White" VerticalAlignment="Center" Width="20" />
                <Grid Grid.Column="1" Margin="10,0" Height="6" VerticalAlignment="Center">
                    <Border Background="#33FFFFFF" CornerRadius="3" />
                    <Border x:Name="LevelFill" Background="White" CornerRadius="3" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="LevelScale" ScaleX="0" /></Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="LevelText" Grid.Column="2" Foreground="White" FontSize="12" Width="28" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Media: cover, title, artist, controls, progress -->
            <Grid x:Name="Media" Margin="14" Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="BigArt" Width="72" Height="72" CornerRadius="14" Background="#333" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                    <TextBlock x:Name="BigTitle" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Không có nhạc" />
                    <TextBlock x:Name="BigArtist" Foreground="#99FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,6" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click" ToolTip="Bài trước" />
                        <Button Style="{StaticResource IconButton}" Click="PlayPause_Click" ToolTip="Phát / Dừng">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontSize="20" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Bài tiếp" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Foreground="#99FFFFFF" FontSize="11" VerticalAlignment="Center" Text="0:00" />
                    <!-- Taller transparent hit area so the 4px bar is easy to click / drag -->
                    <Grid x:Name="ProgressTrack" Grid.Column="1" Margin="10,0" Height="16" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Progress_MouseDown" MouseMove="Progress_MouseMove" MouseLeftButtonUp="Progress_MouseUp">
                        <Border Height="4" Background="#33FFFFFF" CornerRadius="2" />
                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="#99FFFFFF" FontSize="11" VerticalAlignment="Center" Text="0:00" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
